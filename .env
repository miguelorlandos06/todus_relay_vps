# ─── Configuración del relay todus_relay_vps ───
# Copia este fichero a .env y rellena los valores.
# En GitHub Actions, en cambio, define estos valores como secrets/vars del repo
# (ver .github/workflows/relay.yml).

# Secreto compartido en hex (mínimo 32 bytes = 64 chars hex).
# Genéralo con: openssl rand -hex 32
PROXY_SHARED_SECRET=5a3ec890b66067c19a187bb7e117c0f11dd8b3e166bab00d9d96117479b52b24

# URL base del bucket S3 (default: bucket ToDus Cuba).
# Cámbiala si usas otro bucket compatible S3.
TODUS_BASE_URL=https://s3.todus.cu/public

# Verificación TLS (recomendado true).
TODUS_VERIFY_TLS=true

# Cifrado del payload con AES-GCM dentro del sobre TDS3.
# true (default) → los objetos en S3 no son legibles sin el secreto.
# false → escribe TDS2 legacy (HMAC only, payload en claro) para compat con clientes antiguos.
ENCRYPTION_ENABLED=true

# Allowlist de destinos (separados por coma). Vacío = permitir todo (con warning).
# Formato: host:port | host:* | *.domain:port | *.domain:*
# Ejemplo: permitir DNS de Cloudflare y HTTPS a un dominio concreto.
# ALLOWLIST=1.1.1.1:53,*.example.com:443,api.miservidor.com:*

# Borrar bloques tras leerlos (reduce almacenamiento, pero pierde reintentos).
TODUS_DELETE_AFTER_READ=false

# ─── Tuning de red ───
POLL_INTERVAL=0.5
CHUNK_SIZE=1048576
WINDOW_SIZE=24
ACK_EVERY=6
HTTP_TIMEOUT=25
HTTP_RETRIES=4
CONNECT_TIMEOUT=25
WRITE_TIMEOUT=15
QUEUE_POLL_INTERVAL=0.3
MAX_SESSIONS=14

# ─── UDP ───
UDP_BATCH_COUNT=64
UDP_BATCH_DELAY_MS=50
UDP_BATCH_MAX_BYTES=131072
UDP_MAX_FLOWS=160
UDP_POLL_INTERVAL=0.06
UDP_UPLOAD_WORKERS=6

# ─── Operación en GitHub Actions ───
# Heartbeat para evitar cancelación por inactividad (mínimo 5s, máx 300s).
HEARTBEAT_INTERVAL=60
# Duración máxima de una sesión (debe ser < límite de 6h del job).
# Default 14400s = 4h.
SESSION_MAX_DURATION=14400
# Tiempo de gracia para shutdown (SIGTERM → publish close → exit).
SHUTDOWN_TIMEOUT=20

# Nivel de log: debug | info | warn | error
LOG_LEVEL=info

# User-Agent para las peticiones S3 (vacío = curl/8.23.0 por defecto).
# Cambiarlo reduce fingerprinting si tu bucket loguea UA.
# USER_AGENT=Mozilla/5.0

# Cabecera Host opcional para el buzón (v2.0, paridad con la APK que envía
# Host: status.todus.cu). Vacío = usar el host de la URL.
# TODUS_HOST_HEADER=status.todus.cu